# Server-only variables. Never prefix these with NEXT_PUBLIC_.
LAB_ADMIN_USERNAME=carry
# Generate with: node scripts/configure-lab-admin.mjs
LAB_ADMIN_PASSWORD_HASH=
LAB_SESSION_SECRET=
# Runtime password changes require durable private storage; no public/client prefixes.
# Production: blob. Local self-hosting/tests: file (never supported on Vercel).
LAB_AUTH_STORE_MODE=environment
LAB_AUTH_BLOB_STORE_ID=
LAB_AUTH_LOCAL_FILE=
# One-time build migration ONLY; remove after the first successful deployment.
LAB_AUTH_INITIALIZE=

# Experiment data (separate from administrator password storage). Production only.
# Leave LAB_DATA_PROVIDER empty until the private OSS bucket and least-privilege RAM OIDC role are ready.
LAB_DATA_PROVIDER=
LAB_OSS_REGION=oss-ap-southeast-1
LAB_OSS_BUCKET=carry-2025
LAB_OSS_PREFIX=carry-lab-v1/
LAB_OSS_ROLE_ARN=acs:ram::1106221294007096:role/vercelcarrylaboss
LAB_OSS_OIDC_PROVIDER_ARN=acs:ram::1106221294007096:oidc-provider/vercel-carry-lab
# Optional custom HTTPS endpoint for buckets that require a custom domain.
LAB_OSS_ENDPOINT=
LAB_OSS_CNAME=0

# Site studio: dedicated PRIVATE Vercel Blob connected to this project via OIDC.
# Do not reuse the administrator password store ID or the experiment data bucket.
SITE_CONTENT_BLOB_STORE_ID=
# Optional absolute directory for a local-only fixture. Ignored on Vercel.
SITE_CONTENT_LOCAL_DIR=
